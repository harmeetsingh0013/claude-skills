{
  "$id": "non-functional-requirements.schema.json",
  "title": "Non-Functional Requirements Document — data contract",
  "type": "object",
  "required": ["document_id", "product", "version", "created", "input_document", "status", "nfrs", "traceability"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "created": {"type": "string", "minLength": 1},
    "input_document": {
      "type": "object",
      "required": ["type", "version", "validation"],
      "properties": {
        "type": {"type": "string", "enum": ["functional-requirements"]},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "validation": {"type": "string", "enum": ["PASS", "FAIL"]}
      }
    },
    "status": {"type": "string", "enum": ["READY_FOR_ARCHITECTURE", "BLOCKED"]},
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "nfrs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "related_fr", "metric", "target", "priority"],
        "properties": {
          "id": {"type": "string", "pattern": "^NFR-[0-9]{3,}$"},
          "category": {"type": "string", "minLength": 1},
          "related_fr": {
            "type": "array",
            "items": {"type": "string", "pattern": "^FR-[0-9]{3,}$"}
          },
          "metric": {"type": "string", "minLength": 1},
          "target": {"type": "string", "minLength": 1},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}
        }
      }
    },
    "conflicts": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["nfr", "related_fr", "metric", "target", "priority"],
        "properties": {
          "nfr": {"type": "string", "pattern": "^NFR-[0-9]{3,}$"},
          "related_fr": {"type": "array", "items": {"type": "string"}},
          "metric": {"type": "string"},
          "target": {"type": "string"},
          "priority": {"type": "string", "enum": ["P0", "P1", "P2", "P3"]}
        }
      }
    }
  }
}
