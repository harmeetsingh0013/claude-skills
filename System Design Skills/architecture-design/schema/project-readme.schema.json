{
  "$id": "project-readme.schema.json",
  "title": "Project README — data contract",
  "type": "object",
  "required": ["document_id", "product", "version", "created", "status",
               "mvp", "overview", "included_documents", "diagrams_embedded"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "created": {"type": "string", "minLength": 1},
    "status": {"type": "string", "enum": ["READY", "BLOCKED"]},
    "blocking_issues": {
      "type": "array",
      "items": {"type": "string"}
    },
    "mvp": {
      "type": "object",
      "required": ["number", "is_final"],
      "properties": {
        "number": {"type": "integer"},
        "is_final": {"type": "boolean"}
      }
    },
    "overview": {"type": "string", "minLength": 1},
    "included_documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["doc_type", "label", "current_version", "folder_path"],
        "properties": {
          "doc_type": {"type": "string", "minLength": 1},
          "label": {"type": "string", "minLength": 1},
          "current_version": {"type": "string"},
          "folder_path": {"type": "string", "minLength": 1}
        }
      }
    },
    "diagrams_embedded": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "type", "shows"],
        "properties": {
          "filename": {"type": "string", "minLength": 1},
          "type": {"type": "string"},
          "shows": {"type": "string"}
        }
      }
    },
    "sprints_included": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sprint_number", "current_version"],
        "properties": {
          "sprint_number": {"type": "integer"},
          "current_version": {"type": "string"},
          "folder_path": {"type": "string"}
        }
      }
    }
  }
}
