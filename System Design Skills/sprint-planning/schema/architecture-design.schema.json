{
  "$id": "architecture-design.schema.json",
  "title": "System Architecture & Design Document — data contract",
  "type": "object",
  "required": ["document_id", "product", "version", "created", "input_documents", "status", "mvp", "ubiquitous_language", "bounded_contexts", "context_map", "domain_events", "adrs", "components", "diagram_specifications", "traceability"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "created": {"type": "string", "minLength": 1},
    "input_documents": {
      "type": "object",
      "required": ["functional_requirements", "non_functional_requirements"],
      "properties": {
        "functional_requirements": {
          "type": "object",
          "required": ["version", "validation"],
          "properties": {
            "version": {"type": "string"},
            "validation": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        },
        "non_functional_requirements": {
          "type": "object",
          "required": ["version", "validation"],
          "properties": {
            "version": {"type": "string"},
            "validation": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        }
      }
    },
    "status": {"type": "string", "enum": ["READY_FOR_MERMAID", "BLOCKED", "CONFLICT"]},
    "mvp": {
      "type": "object",
      "required": ["number", "is_final"],
      "properties": {
        "number": {"type": "integer"},
        "is_final": {"type": "boolean"}
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string"},
          "message": {"type": "string"}
        }
      }
    },
    "ubiquitous_language": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["term", "definition"],
        "properties": {
          "term": {"type": "string", "minLength": 1},
          "definition": {"type": "string", "minLength": 1},
          "bounded_context": {"type": "string"}
        }
      }
    },
    "bounded_contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "responsibility", "aggregates", "related_requirements"],
        "properties": {
          "id": {"type": "string", "pattern": "^BC-[0-9]{2,}$"},
          "name": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "aggregates": {
            "type": "array",
            "items": {"type": "string"}
          },
          "related_requirements": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "context_map": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "relationship"],
        "properties": {
          "from": {"type": "string", "pattern": "^BC-[0-9]{2,}$"},
          "to": {"type": "string", "pattern": "^BC-[0-9]{2,}$"},
          "relationship": {
            "type": "string",
            "enum": ["Partnership", "Shared Kernel", "Customer-Supplier",
                     "Conformist", "Anticorruption Layer", "Open Host Service",
                     "Published Language", "Separate Ways"]
          },
          "rationale": {"type": "string"}
        }
      }
    },
    "domain_events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "bounded_context"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "bounded_context": {"type": "string", "pattern": "^BC-[0-9]{2,}$"},
          "consumed_by": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "driven_by"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADR-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["Proposed", "Accepted", "Superseded"]},
          "supersedes": {"type": "string"},
          "driven_by": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "responsibility"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "bounded_context": {"type": "string"}
        }
      }
    },
    "diagram_specifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "shows"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {
            "type": "string",
            "enum": ["system-context", "container-architecture", "request-flow",
                     "data-flow", "sequence-diagram", "deployment-architecture",
                     "entity-relationship", "state-diagram", "context-map"]
          },
          "shows": {"type": "string", "minLength": 1}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {"type": "string"}
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "sections"],
        "properties": {
          "requirement_id": {"type": "string"},
          "sections": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
