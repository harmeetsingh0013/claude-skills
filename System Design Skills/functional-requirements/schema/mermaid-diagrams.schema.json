{
  "$id": "mermaid-diagrams.schema.json",
  "title": "Mermaid Diagram Artifacts — data contract",
  "type": "object",
  "required": ["document_id", "product", "version", "created", "input_document", "status", "diagrams"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "created": {"type": "string", "minLength": 1},
    "input_document": {
      "type": "object",
      "required": ["type", "version", "validation"],
      "properties": {
        "type": {"type": "string", "enum": ["architecture-design"]},
        "version": {"type": "string"},
        "validation": {"type": "string", "enum": ["PASS", "FAIL"]}
      }
    },
    "status": {"type": "string", "enum": ["READY", "BLOCKED"]},
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["filename", "type", "shows", "source", "validated"],
        "properties": {
          "filename": {"type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.mmd$"},
          "type": {
            "type": "string",
            "enum": ["system-context", "container-architecture", "request-flow",
                     "data-flow", "sequence-diagram", "deployment-architecture",
                     "entity-relationship", "state-diagram"]
          },
          "shows": {"type": "string", "minLength": 1},
          "source": {"type": "string", "enum": ["mcp", "native"]},
          "validated": {"type": "boolean"}
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
