{
  "$id": "architecture-design.schema.json",
  "title": "System Architecture & Design Document — data contract",
  "type": "object",
  "required": ["document_id", "product", "version", "created", "input_documents",
               "status", "mvp", "architectural_drivers", "architecture_style",
               "components", "adrs", "consistency_model", "risks",
               "open_questions", "traceability"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "product": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "created": {"type": "string", "minLength": 1},
    "input_documents": {
      "type": "object",
      "required": ["functional_requirements", "non_functional_requirements"],
      "properties": {
        "functional_requirements": {
          "type": "object",
          "required": ["version", "validation"],
          "properties": {
            "version": {"type": "string"},
            "validation": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        },
        "non_functional_requirements": {
          "type": "object",
          "required": ["version", "validation"],
          "properties": {
            "version": {"type": "string"},
            "validation": {"type": "string", "enum": ["PASS", "FAIL"]}
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": ["READY_FOR_IMPLEMENTATION_PLANNING", "READY_WITH_ASSUMPTIONS", "BLOCKED"]
    },
    "mvp": {
      "type": "object",
      "required": ["number", "is_final"],
      "properties": {
        "number": {"type": "integer"},
        "is_final": {"type": "boolean"}
      }
    },
    "blocking_conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["conflicting_requirement_ids", "what_conflicts", "why_it_conflicts",
                     "clarification_required", "decisions_that_cannot_be_made"],
        "properties": {
          "conflicting_requirement_ids": {"type": "array", "items": {"type": "string"}},
          "what_conflicts": {"type": "string"},
          "why_it_conflicts": {"type": "string"},
          "clarification_required": {"type": "string"},
          "decisions_that_cannot_be_made": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "statement", "classification", "architectural_impact"],
        "properties": {
          "id": {"type": "string", "pattern": "^A-[0-9]{1,}$"},
          "statement": {"type": "string", "minLength": 1},
          "classification": {"type": "string", "enum": ["ASSUMPTION", "DERIVED", "UNKNOWN"]},
          "architectural_impact": {"type": "string"},
          "if_false": {"type": "string"}
        }
      }
    },
    "architectural_drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["rank", "driver", "reason"],
        "properties": {
          "rank": {"type": "integer", "minimum": 1},
          "driver": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "architecture_style": {
      "type": "object",
      "required": ["selected", "rationale"],
      "properties": {
        "selected": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "alternatives_considered": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "assessment"],
            "properties": {
              "name": {"type": "string"},
              "advantages": {"type": "array", "items": {"type": "string"}},
              "disadvantages": {"type": "array", "items": {"type": "string"}},
              "assessment": {"type": "string"}
            }
          }
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "responsibility"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "responsibility": {"type": "string", "minLength": 1},
          "owned_data": {"type": "string"},
          "not_applicable_reason": {"type": "string"}
        }
      }
    },
    "adrs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "context", "decision", "alternatives", "trade_offs"],
        "properties": {
          "id": {"type": "string", "pattern": "^ADR-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["Proposed", "Accepted", "Superseded"]},
          "supersedes": {"type": "string"},
          "context": {"type": "string", "minLength": 1},
          "decision": {"type": "string", "minLength": 1},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "trade_offs": {"type": "string", "minLength": 1},
          "driven_by": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "consistency_model": {
      "type": "object",
      "required": ["strong_consistency_areas", "eventual_consistency_areas"],
      "properties": {
        "strong_consistency_areas": {"type": "array", "items": {"type": "string"}},
        "eventual_consistency_areas": {"type": "array", "items": {"type": "string"}},
        "not_applicable_reason": {"type": "string"}
      }
    },
    "capacity_model": {
      "type": "object",
      "properties": {
        "status": {"type": "string", "enum": ["COMPLETE", "INCOMPLETE", "NOT_MATERIAL"]},
        "missing_inputs": {"type": "array", "items": {"type": "string"}},
        "formulas": {"type": "array", "items": {"type": "string"}}
      }
    },
    "technology_selection": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["capability", "selected"],
        "properties": {
          "capability": {"type": "string"},
          "selected": {"type": "string"},
          "rationale": {"type": "string"},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "verification_required": {"type": "boolean"}
        }
      }
    },
    "trade_offs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["tension", "resolution"],
        "properties": {
          "tension": {"type": "string"},
          "resolution": {"type": "string"}
        }
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["failure_mode", "impact", "mitigation"],
        "properties": {
          "failure_mode": {"type": "string"},
          "impact": {"type": "string"},
          "mitigation": {"type": "string"}
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "risk", "mitigation"],
        "properties": {
          "id": {"type": "string", "pattern": "^R-[0-9]{3,}$"},
          "risk": {"type": "string"},
          "severity": {"type": "string", "enum": ["Low", "Medium", "High"]},
          "mitigation": {"type": "string"}
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {"type": "string"}
    },
    "traceability": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "architectural_response"],
        "properties": {
          "requirement_id": {"type": "string"},
          "architectural_response": {"type": "string"}
        }
      }
    },
    "not_applicable_sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["section", "reason"],
        "properties": {
          "section": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  }
}
